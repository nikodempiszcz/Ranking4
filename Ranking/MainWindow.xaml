<Window x:Class="Ranking.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ranking"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Background="Navy">
    <Grid>
        <TextBlock Text="Bez użyteczny formularz" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0"/>
        <TextBlock Text="Wprowadź swoje dane:" FontSize="18" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,80,0,0"/>
        <TextBlock Text="Imię:" FontSize="16" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="40,120,0,0"/>
        <TextBox x:Name="NameTextBox" Width="200" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="100,120,0,0"/>
        <TextBlock Text="Nazwisko:" FontSize="16" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="22,160,0,0"/>
        <TextBox x:Name="SurnameTextBox" Width="200" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="100,160,0,0"/>
        <Button Content="Zapisz i idz dalej" Width="100" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="100,200,0,0" Click="SaveButton_Click"/>
    </Grid>
</Window>
